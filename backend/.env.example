DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=servicios_app
PORT=3001
# Obligatorio: cualquier cadena larga y secreta
JWT_SECRET=

# Solo para bases en la nube que exigen SSL (Aiven): certificado CA completo,
# desde "-----BEGIN CERTIFICATE-----" hasta "-----END CERTIFICATE-----".
# En local déjalo vacío.
DB_SSL_CA=

# Opcional: carpeta donde se guardan las imágenes subidas (por defecto ./uploads)
UPLOADS_DIR=
# URL pública del servidor para armar URLs absolutas de imágenes. En producción
# ponla siempre (p. ej. https://oficiolink-api.onrender.com); en local se deja vacía
# y se usa el host con el que llega cada petición.
PUBLIC_URL=
