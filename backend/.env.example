DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=servicios_app
# La app Flutter busca el backend en este puerto
PORT=3001
# Obligatorio: cualquier cadena larga y secreta
JWT_SECRET=

# Opcional: carpeta donde se guardan las imágenes subidas (por defecto ./uploads)
UPLOADS_DIR=
# Opcional: URL pública del servidor para armar URLs absolutas de imágenes
# (por defecto se usa el host con el que llega cada petición)
PUBLIC_URL=

# Inicio de sesión con Google: ID(s) de cliente OAuth de Google Cloud,
# separados por coma (web, Android...). Ver GUIA_LOGIN_SOCIAL.md
GOOGLE_CLIENT_IDS=

# Inicio de sesión con Facebook: datos de tu app en developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
